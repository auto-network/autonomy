#!/usr/bin/env bash
# Run a PowerShell script on a test instance AS the local user `tester`, not
# SYSTEM (WSL refuses LocalSystem: Wsl/WSL_E_LOCAL_SYSTEM_NOT_SUPPORTED).
# Wraps the script in a one-shot scheduled task, waits, prints its output.
# Usage: tools/cloud/win-run-user <instance-id> <script-file|-> [timeout-s]
set -euo pipefail
IID="$1"; SRC="${2:--}"; TIMEOUT="${3:-1800}"
HERE="$(dirname "$0")"
F=/run/secrets/aws-win-tester
[[ -s $F ]] || F="$(graph vault read aws-win-tester --org autonomy | tail -1)"
PW="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["password"])' "$F")"
B64="$(iconv -f UTF-8 -t UTF-16LE <(cat "$SRC") | base64 -w0)"
"$HERE/win-run" "$IID" - "$TIMEOUT" <<PS
\$ErrorActionPreference = 'Stop'
\$d = 'C:\\autonomy-test'; New-Item -ItemType Directory -Force \$d | Out-Null
\$job = "\$d\\job-\$([guid]::NewGuid().ToString('N')).ps1"
[IO.File]::WriteAllText(\$job, [Text.Encoding]::Unicode.GetString([Convert]::FromBase64String('$B64')))
\$out = "\$job.out"
\$a = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument "-NoProfile -ExecutionPolicy Bypass -Command & '\$job' *> '\$out'; exit \\\$LASTEXITCODE"
\$name = 'autonomy-job'
Unregister-ScheduledTask -TaskName \$name -Confirm:\$false -ErrorAction SilentlyContinue
Register-ScheduledTask -TaskName \$name -Action \$a -User 'tester' -Password '$PW' -RunLevel Highest -Settings (New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Seconds $TIMEOUT)) | Out-Null
Start-ScheduledTask -TaskName \$name
Start-Sleep 2
while ((Get-ScheduledTask -TaskName \$name).State -eq 'Running') { Start-Sleep 3 }
\$r = (Get-ScheduledTaskInfo -TaskName \$name).LastTaskResult
if (Test-Path \$out) { Get-Content \$out | ForEach-Object { \$_ -replace "\`0","" } }
Unregister-ScheduledTask -TaskName \$name -Confirm:\$false
"== task result: \$r"
PS
