{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomy:keyreg:v1",
  "title": "Key registry",
  "description": "Machine-readable inventory of every key and mutation in the vault + storage system. Design: graph note 879ccc1e-b49. keyreg.py implements these constraints natively for environments without a jsonschema library; this file is the canonical contract. The optional actors/artifacts/goals sections and the mutation fields actors/opens/requires/produces/rule record workflow prerequisites as an AND/OR graph for keyreg.py plan.",
  "type": "object",
  "required": ["version", "keys", "mutations", "purposes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "keys": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/key"}
    },
    "mutations": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.:-]*$"},
      "additionalProperties": {"$ref": "#/$defs/mutation"}
    },
    "purposes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/purpose"}
    },
    "actors": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/actor"}
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "goals": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/goal"}
    }
  },
  "$defs": {
    "codeAnchor": {
      "type": "string",
      "description": "Repo-relative file path, optionally followed by ':' and a symbol name defined in that file.",
      "pattern": "^[A-Za-z0-9_./-]+\\.(py|js|mjs|go|sh|spthy)(:[A-Za-z_][A-Za-z0-9_.]*)?$"
    },
    "descriptor": {
      "type": "object",
      "description": "The six-field per-key descriptor of crib sheet section 9 (class and its forcing fact live under custody).",
      "required": ["reaches", "snapshot", "live", "revoke", "bound"],
      "additionalProperties": false,
      "properties": {
        "reaches": {"type": "string", "minLength": 1},
        "snapshot": {"type": "string", "minLength": 1},
        "live": {"type": "string", "minLength": 1},
        "revoke": {"type": "string", "minLength": 1},
        "bound": {"type": "string", "minLength": 1}
      }
    },
    "key": {
      "type": "object",
      "required": ["kind", "custody", "derivation", "descriptor", "code", "crib"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["seed", "signing", "kem", "symmetric", "derived-secret"]},
        "group": {
          "type": "string",
          "description": "Subsystem cluster for generated views (e.g. identity-armor, recovery, vault-classes)."
        },
        "status": {
          "enum": ["built", "designed"],
          "default": "built",
          "description": "designed = the flow exists only in the design of record; code may then be empty."
        },
        "custody": {
          "type": "object",
          "required": ["class", "forced_by"],
          "additionalProperties": false,
          "properties": {
            "class": {"enum": ["cold", "memory", "disk", "public"]},
            "forced_by": {"type": "string", "minLength": 1}
          }
        },
        "derivation": {
          "oneOf": [
            {"type": "null", "description": "Minted at random."},
            {
              "type": "object",
              "required": ["parent", "fn"],
              "additionalProperties": false,
              "properties": {
                "parent": {"type": "string", "description": "Key id of the derivation parent."},
                "fn": {"type": "string"},
                "inputs": {"type": "array", "items": {"type": "string"}},
                "purpose": {"type": "string"}
              }
            }
          ]
        },
        "descriptor": {"$ref": "#/$defs/descriptor"},
        "seals_to": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recipient"],
            "additionalProperties": false,
            "properties": {
              "recipient": {"type": "string", "description": "Key id, or a prose recipient description."},
              "purpose": {"type": "string"},
              "record": {"type": "string"}
            }
          }
        },
        "signs": {"type": "array", "items": {"type": "string"}},
        "code": {"type": "array", "items": {"$ref": "#/$defs/codeAnchor"}},
        "crib": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "proofs": {"type": "array", "items": {"$ref": "#/$defs/proofRef"}},
        "notes": {"type": "string"}
      }
    },
    "mutation": {
      "type": "object",
      "required": ["source", "authority", "effects", "crib"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["built", "designed"],
          "default": "built",
          "description": "designed = the flow exists only in the design of record; the source anchor then points at its formal spec."
        },
        "source": {
          "type": "object",
          "required": ["kind", "file"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["fold", "ceremony", "module-op", "route"]},
            "file": {"type": "string"},
            "symbol": {"type": "string"}
          }
        },
        "authority": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mints": {"type": "array", "items": {"type": "string"}},
            "seals": {"type": "array", "items": {"type": "string"}},
            "revokes": {"type": "array", "items": {"type": "string"}},
            "writes": {"type": "array", "items": {"type": "string"}}
          }
        },
        "refusals": {"type": "array", "items": {"type": "string"}},
        "crib": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "proofs": {"type": "array", "items": {"$ref": "#/$defs/proofRef"}},
        "notes": {"type": "string"},
        "actors": {
          "type": "array", "minItems": 1, "items": {"type": "string"},
          "description": "Actor ids that execute this mutation in a planned workflow."
        },
        "opens": {
          "enum": ["root", "persona", "delegate", "none"],
          "description": "root and persona need a human root-opening window (the persona is derived from the root in the browser); delegate uses a hot delegate key; none uses no key."
        },
        "requires": {
          "type": "array", "items": {"$ref": "#/$defs/reqExpr"},
          "description": "Implicit AND of artifact or key requirements; any/all nest."
        },
        "produces": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "rule": {
          "type": "string", "pattern": "^[a-z][a-z0-9_]*$",
          "description": "For a designed mutation: the proposed rule that keyreg.py plan --rule enables."
        }
      },
      "dependentRequired": {
        "opens": ["actors", "requires", "produces"],
        "actors": ["opens"], "requires": ["opens"], "produces": ["opens"]
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(@[a-z][a-z0-9_]*)?$",
      "description": "An artifact id, optionally suffixed @actor, or a key id."
    },
    "reqExpr": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {
          "type": "object", "required": ["all"], "additionalProperties": false,
          "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reqExpr"}}}
        },
        {
          "type": "object", "required": ["any"], "additionalProperties": false,
          "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reqExpr"}}}
        }
      ]
    },
    "actor": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {"description": {"type": "string", "minLength": 1}}
    },
    "artifact": {
      "type": "object",
      "description": "A workflow prerequisite that is not a key: an event, row, certificate or registry state.",
      "required": ["description", "store", "home", "code"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "store": {"type": "string", "minLength": 1},
        "home": {"type": "string", "minLength": 1},
        "code": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/codeAnchor"}},
        "per_actor": {"type": "boolean", "default": false},
        "status": {"enum": ["built", "designed"], "default": "built"},
        "notes": {"type": "string"}
      }
    },
    "step": {
      "type": "object",
      "required": ["step", "actor", "ceremony", "runs"],
      "additionalProperties": false,
      "properties": {
        "step": {"type": "string", "minLength": 1},
        "actor": {"type": "string"},
        "ceremony": {"type": "boolean", "description": "true: this step is one human root opening."},
        "runs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "only_from": {"type": "array", "items": {"type": "string"}}
      }
    },
    "defect": {
      "type": "object",
      "description": "A recorded current-code defect the order lints report; a stale entry is itself an error.",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "step": {"type": "string"},
        "mutation": {"type": "string"},
        "missing": {"$ref": "#/$defs/ref"},
        "artifact": {"$ref": "#/$defs/ref"},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "goal": {
      "type": "object",
      "required": ["description", "requires", "states"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "requires": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reqExpr"}},
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "holds"],
            "additionalProperties": false,
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "holds": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
            }
          }
        },
        "current_order": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "known_defects": {"type": "array", "items": {"$ref": "#/$defs/defect"}},
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "rules", "current", "minimal"],
            "additionalProperties": false,
            "properties": {
              "from": {"type": "string"},
              "rules": {"type": "array", "items": {"type": "string"}},
              "current": {"$ref": "#/$defs/counts"},
              "minimal": {"$ref": "#/$defs/counts"}
            }
          }
        },
        "proofs": {"type": "array", "items": {"$ref": "#/$defs/proofRef"}},
        "notes": {"type": "string"}
      }
    },
    "proofRef": {
      "type": "object",
      "required": ["framework", "theory", "lemma"],
      "additionalProperties": false,
      "properties": {
        "framework": {"enum": ["tamarin", "tla"]},
        "theory": {"type": "string"},
        "lemma": {"type": "string"}
      }
    },
    "purpose": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "used_by": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
