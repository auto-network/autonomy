/*
  VaultPolicyClassNoAnchor — model 8 calibration B: generation 2 is
  minted without the root-anchor wrap. Identical to
  VaultPolicyClass.spthy except Revoke_F2 seals the fresh class_key to
  the survivor only — the record VaultStore.put_class refuses to
  persist ("a member class must seal to the personal-root anchor;
  enclaves are unbuildable", policy_class.py:create_class and
  store.py:put_class).

  Expected: root_reaches_every_generation falsified — with no member
  factor present the root opens generation 1 but has NO route into
  generation 2, exactly the new-device lockout the mandatory anchor
  exists to prevent. Every other lemma must hold: forward exclusion,
  old-generation readability, and executability never involve the
  anchor — the deleted wrap is load-bearing ONLY for root reach.
*/

theory VaultPolicyClassNoAnchor
begin

builtins: asymmetric-encryption

functions: recipientkey/1, sealkey/1

rule Enroll_Class:
  [ Fr(~k1), Fr(~f1), Fr(~f2), Fr(~anchor) ]
  --[ ClassMinted(~k1), OnceEnroll() ]->
  [ !F1Seed(~f1), !F2Seed(~f2), !AnchorSeed(~anchor)
  , !Gen1Key(~k1)
  , Out(aenc(~k1, pk(recipientkey(~f1))))
  , Out(aenc(~k1, pk(recipientkey(~f2))))
  , Out(aenc(~k1, pk(recipientkey(~anchor))))
  , Out(pk(sealkey(~k1)))
  ]

restriction once_enroll:
  "All #i #j. OnceEnroll()@i & OnceEnroll()@j ==> #i = #j"

rule Write_Gen1:
  [ !Gen1Key(~k1), Fr(~cek) ]
  --[ WroteOld(~cek) ]->
  [ Out(aenc(~cek, pk(sealkey(~k1)))) ]

/* CALIBRATION: the anchor wrap is deleted from the new generation. */
rule Revoke_F2:
  [ !F1Seed(~f1), !AnchorSeed(~anchor), !Gen1Key(~k1), Fr(~k2) ]
  --[ Revoked(), Gen2Minted(~k2), OnceRevoke() ]->
  [ !Gen2Key(~k2)
  , Out(aenc(~k2, pk(recipientkey(~f1))))
  , Out(pk(sealkey(~k2)))
  ]

restriction once_revoke:
  "All #i #j. OnceRevoke()@i & OnceRevoke()@j ==> #i = #j"

rule Write_Gen2:
  [ !Gen2Key(~k2), Fr(~cek) ]
  --[ WroteNew(~cek) ]->
  [ Out(aenc(~cek, pk(sealkey(~k2)))) ]

rule Read_As_Survivor:
  [ !F1Seed(~f1)
  , In(aenc(k, pk(recipientkey(~f1))))
  , In(aenc(cek, pk(sealkey(k))))
  ]
  --[ SurvivorRead(cek) ]->
  [ ]

rule Reveal_Survivor:
  [ !F1Seed(~f1) ]         --[ RevealedSurvivor() ]-> [ Out(~f1) ]

rule Reveal_Revoked:
  [ !F2Seed(~f2) ]         --[ RevealedRevoked() ]->  [ Out(~f2) ]

rule Reveal_Anchor:
  [ !AnchorSeed(~anchor) ] --[ RevealedAnchor() ]->   [ Out(~anchor) ]

/* ═══ Lemmas — verbatim from VaultPolicyClass.spthy ═══ */

lemma executable:
  exists-trace
  "Ex kc c1 c2 #m #w1 #r #w2 #s1 #s2.
      ClassMinted(kc)@m & WroteOld(c1)@w1 & Revoked()@r & WroteNew(c2)@w2
    & SurvivorRead(c1)@s1 & SurvivorRead(c2)@s2"

lemma revoked_factor_excluded_forward:
  "not(Ex c #w #r #k.
        WroteNew(c)@w & RevealedRevoked()@r & K(c)@k
      & not(Ex #q1. RevealedSurvivor()@q1)
      & not(Ex #q2. RevealedAnchor()@q2))"

lemma revoked_factor_keeps_old:
  exists-trace
  "Ex c #w #r #k.
      WroteOld(c)@w & RevealedRevoked()@r & K(c)@k
    & not(Ex #q1. RevealedSurvivor()@q1)
    & not(Ex #q2. RevealedAnchor()@q2)"

lemma root_reaches_every_generation:
  exists-trace
  "Ex c1 c2 #w1 #w2 #r #k1 #k2.
      WroteOld(c1)@w1 & WroteNew(c2)@w2 & RevealedAnchor()@r
    & K(c1)@k1 & K(c2)@k2
    & not(Ex #q1. RevealedSurvivor()@q1)
    & not(Ex #q2. RevealedRevoked()@q2)"

end
