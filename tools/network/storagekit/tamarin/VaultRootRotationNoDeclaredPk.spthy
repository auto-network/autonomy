/*
  VaultRootRotationNoDeclaredPk — model 9 calibration B: a RELYING
  PARTY that resolves the recovery public key from attacker-suppliable
  input instead of the key it pinned is defeated. Identical to
  VaultRootRotation.spthy except Accept_Rotation reads rpk from In() —
  no !DeclaredRecoveryPk premise — modeling a verifier that takes
  recovery_pub from the request rather than from its own pinned record.

  WHO THIS PROPERTY IS ABOUT (framing corrected 2026-08-29 after
  operator review; earlier drafts of this header were wrong and are
  superseded). A personal-root succession has no meaning until a party
  OTHER than the machine that produced it accepts it, because a machine
  checking a succession against a key it read from the same request is
  checking nothing — an attacker who holds that machine controls both
  sides. Under the governing threat model (crib graph://1e005d5c-c11
  §0: host write access is out of scope; "the OWNER REWRITING THEIR OWN
  STORE IS A FEATURE"), a local self-check is not a security boundary.
  The two parties that actually decide whether a new root is you are:
    - your FLEET machines, which accept another machine as you only
      against root-signed roster material (RosterEntry is root-signed,
      fleet_roster.py; producing that signature needs the root seed,
      released only by your factors — VaultFactorPolicy, model 7); and
    - the RELAY / auto.network registry, which rebinds your identity to
      a new root only for a request signed by the recovery key it
      pinned at enrollment (registry/app.py:823: "the ONLY key that can
      sign a rebind is the pre-declared cold recovery key").
  An attacker who steals your data but not your factors, and who edits
  their own machine's code to accept a recovery key they minted,
  convinces neither: the fabricated root is not root-signed into any
  honest fleet machine's roster, and the registry keeps pointing at the
  old root. idkit/root_rotation.py's verify_rotation is NOT one of
  these relying parties — it is a local helper with no party on the
  other side — so its caller-supplied recovery_pub is not a defect and
  needs no change. This calibration models the requirement on the
  parties that ARE relying: they must resolve recovery_pub from their
  own pinned record, never from the request.

  Expected: thief_cannot_rotate falsified (trace via
  `tamarin-prover --prove VaultRootRotationNoDeclaredPk.spthy`): the
  thief reveals the old root, mints a recovery keypair IT controls,
  supplies its own public key as "the" recovery key, co-signs the
  rotation itself, and is accepted — a check correctly performed
  against a key the relying party did not pin. Every other lemma holds:
  the owner still rotates (the relying party's own pinned key is
  public), the code-finder direction still fails on the old-root
  signature, both_secrets is unchanged, recovery_pk_is_declared
  verifies vacuously (the pinned binding it speaks of is deleted here).

  Distinct from VaultRootRotationNoCosign.spthy: there the recovery
  co-signature check is SKIPPED; here it is PERFORMED against an
  unpinned key. Both collapse to the same thief win. registry/app.py:823
  already implements the defended behaviour — it reads recovery_pub
  from the stored binding and rejects a signer mismatch — so this
  theory is a model of why that server-side resolution is load-bearing,
  not a report of a missing check.
*/

theory VaultRootRotationNoDeclaredPk
begin

builtins: signing

/* One lineage: the origin identity, its enrolled recovery key, and
   the declared-recovery binding the unbuilt registry will own. */
rule Setup:
  [ Fr(~old), Fr(~rec) ]
  --[ Enrolled(pk(~old)), DeclaredRecovery(pk(~rec)), OnceSetup() ]->
  [ !OldRoot(~old), !RecoveryKey(~rec)
  , !Origin(pk(~old)), !DeclaredRecoveryPk(pk(~rec))
  , Out(pk(~old)), Out(pk(~rec))
  ]

restriction once_setup:
  "All #i #j. OnceSetup()@i & OnceSetup()@j ==> #i = #j"

/* The owner (armor + printed code) builds one succession record —
   make_rotation's three signatures over the shared binding. */
rule Owner_Rotate:
  [ !OldRoot(~old), !RecoveryKey(~rec), Fr(~new) ]
  --[ OwnerRotated(pk(~old), pk(~new)) ]->
  [ Out(pk(~new))
  , Out(< pk(~old), pk(~new)
        , sign(<'rot',  pk(~old), pk(~new)>, ~old)
        , sign(<'cont', pk(~old), pk(~new)>, ~new)
        , sign(<'rec',  pk(~old), pk(~new)>, ~rec)
        >)
  ]

/* The relying party: verify_rotation + resolve_current_root's
   chain-start check, against the DECLARED recovery pk. The record
   arrives over the open store/network (In). */
/* CALIBRATION: rpk arrives from the network, not the declaration. */
rule Accept_Rotation:
  [ !Origin(opk), In(rpk)
  , In(<old_pub, new_pub, old_sig, new_sig, rec_sig>)
  ]
  --[ Eq(verify(old_sig, <'rot',  old_pub, new_pub>, old_pub), true)
    , Eq(verify(new_sig, <'cont', old_pub, new_pub>, new_pub), true)
    , Eq(verify(rec_sig, <'rec',  old_pub, new_pub>, rpk),     true)
    , Eq(old_pub, opk)
    , RotationAccepted(old_pub, new_pub)
    ]->
  [ ]

restriction equality:
  "All x y #i. Eq(x, y)@i ==> x = y"

/* Compromise: either secret may fall alone — or both. */
rule Reveal_OldRoot:
  [ !OldRoot(~old) ]    --[ RevealedOldRoot() ]->  [ Out(~old) ]

rule Reveal_Recovery:
  [ !RecoveryKey(~rec) ] --[ RevealedRecovery() ]-> [ Out(~rec) ]

/* ═══ Lemmas ═══ */

/* Reachability / executability: with the armor already stolen (old
   root revealed) but the printed code safe, the owner completes a
   rotation away from the stolen root and the verifier accepts it —
   the elegant wipe actually runs under the compromise it exists for. */
lemma owner_rotates_away_from_stolen_root:
  exists-trace
  "Ex o n #a #b #r.
      OwnerRotated(o, n)@a & RotationAccepted(o, n)@b & RevealedOldRoot()@r
    & not(Ex #q. RevealedRecovery()@q)"

/* MAIN — the thief direction: while the recovery key is unrevealed,
   every accepted rotation is one the owner authored — even though the
   old root may be fully public. The thief cannot rotate the identity
   to a key of their choosing. Derived Dolev-Yao result (recovery
   co-signature unforgeability over the exact binding). */
lemma thief_cannot_rotate:
  "All o n #i.
      RotationAccepted(o, n)@i & not(Ex #q. RevealedRecovery()@q)
    ==> Ex #j. OwnerRotated(o, n)@j"

/* MAIN — the code-finder direction: while the old root is unrevealed,
   every accepted rotation is the owner's — the printed code alone
   cannot produce the old root's authorising signature. */
lemma code_finder_cannot_rotate:
  "All o n #i.
      RotationAccepted(o, n)@i & not(Ex #q. RevealedOldRoot()@q)
    ==> Ex #j. OwnerRotated(o, n)@j"

/* Authority is exactly the pair: with BOTH secrets revealed the
   adversary forges an accepted rotation the owner never made. Guards
   both MAIN premises against vacuity (acceptance and adversarial
   signing are demonstrably live) and states honestly what full
   compromise costs. */
lemma both_secrets_suffice:
  exists-trace
  "Ex o n #i #r1 #r2.
      RotationAccepted(o, n)@i
    & RevealedOldRoot()@r1 & RevealedRecovery()@r2
    & not(Ex o2 n2 #j. OwnerRotated(o2, n2)@j)"

/* CONTRACT-CONSISTENCY — the verifier resolves the recovery pk from
   the honest declaration, never from attacker-suppliable input. This
   restates the honest-binding assumption standing in for the unbuilt
   declaration registry (see MODEL.md). */
lemma recovery_pk_is_declared:
  "All rpk #i. UsedRecoveryPk(rpk)@i ==> Ex #j. DeclaredRecovery(rpk)@j"

end
