# auto.network coturn — generated at service start.
# The deployed file lives only under /run and contains the TURN REST secret.

realm=turn.auto.network
server-name=turn.auto.network
fingerprint
use-auth-secret
@@STATIC_AUTH_SECRETS@@

listening-ip=@@TURN_PUBLIC_IP@@
relay-ip=@@TURN_PUBLIC_IP@@
listening-port=3478
tls-listening-port=443
min-port=@@TURN_RELAY_MIN_PORT@@
max-port=@@TURN_RELAY_MAX_PORT@@

cert=/etc/coturn/tls-cert.pem
pkey=/etc/coturn/tls-key.pem
cipher-list=ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!MD5:!DSS
# Coturn 4.17 defaults to modern TLS; the legacy `tlsv1` / `tlsv1_1` flags
# lower that minimum and are deliberately absent. DTLS is opt-in in this
# release and the deployment does not enable it.

# Client connections may use UDP, TCP, or TLS. RFC 6062 TCP peer relaying is
# a different feature and is outside the browser DataChannel requirement.
no-tcp-relay
no-multicast-peers
# Coturn 4.17 keeps its administrative CLI off unless `cli` is explicitly
# enabled. Do not add that opt-in; there is no management listener here.
no-dynamic-ip-list
no-dynamic-realms
no-auth-pings
unauthorized-ratelimit
unauthorized-ratelimit-rps=10
# RFC 5780 is off by default in coturn 4.17. Do not add its `rfc5780` opt-in:
# it binds alternate ports and increases amplification potential. The old
# `no-rfc5780` spelling is deprecated and therefore deliberately absent too.

stale-nonce=600
max-allocate-lifetime=600
user-quota=@@TURN_USER_QUOTA@@
total-quota=@@TURN_TOTAL_QUOTA@@
max-bps=@@TURN_MAX_BPS@@
bps-capacity=@@TURN_BPS_CAPACITY@@

# IPv4 is the first deployment. Coturn binds only the host's floating IPv4
# and defaults allocations to IPv4. IPv6 stays off until the public route and
# mapped-address refusal matrix pass.
allocation-default-address-family=ipv4

# The relay must never become a route into this host, its cloud metadata, or
# non-public networks. Ranges cover special-use, private, shared, benchmark,
# documentation, multicast, and reserved IPv4 space.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-239.255.255.255
denied-peer-ip=240.0.0.0-255.255.255.255

# Do not add IPv6 deny ranges while this service is IPv4-only. coturn compares
# ordinary IPv4 peers in IPv4-mapped form, and a broad IPv6 range can therefore
# shadow legitimate public IPv4 destinations. Enabling IPv6 requires the
# destination-policy and real-data acceptance gate documented in the runbook.

prometheus
prometheus-address=127.0.0.1
prometheus-port=9641
prometheus-path=/metrics

# Username labels stay disabled by deliberately omitting coturn's opt-in
# `prometheus-username-labels` setting. REST usernames are ephemeral and would
# turn metrics into both an identity surface and unbounded cardinality.

log-file=stdout
simple-log
