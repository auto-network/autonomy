# Copy to /etc/autonomy-coturn/runtime.env and replace every blank.
# The sample deliberately contains no guessed production capacity claim.
TURN_PUBLIC_IP=
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49259
TURN_USER_QUOTA=
TURN_TOTAL_QUOTA=
TURN_MAX_BPS=
TURN_BPS_CAPACITY=
TURN_CONTAINER_MEMORY=512m
TURN_CONTAINER_CPUS=1.0
# Filled by deploy.sh from the dedicated host group; do not guess it.
TURN_RUNTIME_GID=
