# Copy to /etc/autonomy-coturn/runtime.env and fill the host-specific values.
# These first operating limits passed the production WebRTC allocation shape:
# one browser and one Dashboard may briefly reserve several TURN allocations
# while gathering candidates. Coturn reserves TURN_MAX_BPS against
# TURN_BPS_CAPACITY at allocation time, before any application bytes flow.
TURN_PUBLIC_IP=
TURN_INTERFACE=eth0
TURN_PRIMARY_IP=5.161.219.195
TURN_GATEWAY=172.31.1.1
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49259
TURN_USER_QUOTA=16
TURN_TOTAL_QUOTA=96
TURN_MAX_BPS=8388608
TURN_BPS_CAPACITY=805306368
TURN_CONTAINER_MEMORY=512m
TURN_CONTAINER_CPUS=1.0
# Filled by deploy.sh from the dedicated host group; do not guess it.
TURN_RUNTIME_GID=
