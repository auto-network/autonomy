# auto.network registry v1 — systemd unit.
#
# Deploy target: the scripted auto.network estate (cattle, not pets —
# graph note 8cb2a39c-4bc). The service binds loopback only; the estate's
# Caddy front terminates TLS and reverse-proxies to it.
#
# Installed by deploy.sh to /etc/systemd/system/autonomy-registry.service.

[Unit]
Description=auto.network registry v1 (org bindings, share-link grants, revocations)
After=network-online.target autonomy-serve-ip.service
Wants=network-online.target
Requires=autonomy-serve-ip.service

[Service]
Type=simple
DynamicUser=true
StateDirectory=autonomy-registry
WorkingDirectory=/opt/autonomy-registry
# The serve floating IP (SERVE_BIND_IP, bound by autonomy-serve-ip.service) is
# read from the shared serve env so the raw tls-stream ingress can be the public
# serve edge directly on :443 — no loopback forward, no PROXY header.
EnvironmentFile=/etc/autonomy-serve/serve.env
# --base-url controls only the public URL returned for a minted grant. The
# registry API remains on registry.auto.network; public viewers use the relay
# hostname. Tokens themselves are hostname-independent.
# --stream-ingress-*: the raw tls-stream ingress (auto-9z1xh) binds the serve
# floating IP's :443 itself, so the socket peer IS the real client and the
# source IP is native — no serve_forward hop, no PROXY v2 trust seam.
# Binding a privileged port under DynamicUser needs CAP_NET_BIND_SERVICE.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/opt/autonomy-registry/venv/bin/python -m tools.network.registry \
    --db /var/lib/autonomy-registry/registry.db \
    --version-file /opt/autonomy-registry/REVISION.json \
    --host 127.0.0.1 --port 8477 \
    --base-url https://relay.auto.network \
    --stream-ingress-host ${SERVE_BIND_IP} \
    --stream-ingress-port 443 \
    --metrics-port 9479
Restart=on-failure
RestartSec=2

# Hardening: the service needs nothing but its code and its state dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
