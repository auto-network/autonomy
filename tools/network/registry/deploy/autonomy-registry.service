# auto.network registry v1 — systemd unit.
#
# Deploy target: the scripted auto.network estate (cattle, not pets —
# graph note 8cb2a39c-4bc). The service binds loopback only; the estate's
# Caddy front terminates TLS and reverse-proxies to it.
#
# Installed by deploy.sh to /etc/systemd/system/autonomy-registry.service.

[Unit]
Description=auto.network registry v1 (org bindings, share-link grants, revocations)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
StateDirectory=autonomy-registry
WorkingDirectory=/opt/autonomy-registry
# --base-url controls only the public URL returned for a minted grant. The
# registry API remains on registry.auto.network; public viewers use the relay
# hostname. Tokens themselves are hostname-independent.
# --stream-ingress-port: the raw tls-stream ingress (auto-9z1xh). The serve
# edge forward (serve_forward.py) reaches it over loopback, so
# --stream-proxy-source 127.0.0.1 trusts a PROXY v2 header (real client
# address, auto-p20eb) only from that hop; a header from any other peer is
# dropped. A forward that predates PROXY v2 sends none and is still parsed
# as TLS, so rollout ordering is free.
ExecStart=/opt/autonomy-registry/venv/bin/python -m tools.network.registry \
    --db /var/lib/autonomy-registry/registry.db \
    --version-file /opt/autonomy-registry/REVISION.json \
    --host 127.0.0.1 --port 8477 \
    --base-url https://relay.auto.network \
    --stream-ingress-port 8479 \
    --stream-proxy-source 127.0.0.1 \
    --metrics-port 9479
Restart=on-failure
RestartSec=2

# Hardening: the service needs nothing but its code and its state dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
