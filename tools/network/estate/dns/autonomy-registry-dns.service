[Unit]
Description=serve.auto.network authoritative DNS (registry-embedded, own process)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
# :53 without root; everything else locked down like the registry unit.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
WorkingDirectory=/opt/autonomy-registry
Environment=PYTHONPATH=/opt/autonomy-registry
EnvironmentFile=/etc/autonomy-dns/dns.env
ExecStart=/opt/autonomy-registry/venv/bin/python -m tools.network.registry.dns_server \
    --bind ${DNS_BIND} --node-id ${DNS_NODE_ID} \
    --relay-ip ${DNS_RELAY_IP} \
    --registry-url http://127.0.0.1:8477
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
