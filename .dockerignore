# Build context hygiene for deploy/Dockerfile (home-base image).
# Persistent/host state never ships in the image — it lives in the
# /app/data volume, created by first-run init (tools/init).
#
# NOTE: .git is intentionally NOT excluded. deploy/Dockerfile's builder stage
# reads the commit hash + commit date from it to stamp /app/VERSION, then drops
# it — the final image (and the autonomy-code volume it seeds) still ships bare
# files with no .git. Only deploy/Dockerfile builds from this context; the agent
# images use their own flat context (agents/build.sh), so this does not put .git
# in any other image.

.gitignore
.venv
.browser_profile
data
node_modules
**/__pycache__
**/*.pyc
.pytest_cache
.dockerignore
docker-compose.yml

# Host-local binaries (gitignored anyway; agent images copy these, the
# home-base image does not)
agents/bin
agents/images
tools/dashboard/tailwindcss

# Scratch
*.log
/tmp
