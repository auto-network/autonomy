{
    "name": "autonomy/jira",
    "version": 1,
    "implements": [
        {"contract": "issue_tracker", "version": 1}
    ],
    "delivery_mode": "mounted_tools",
    "package_root": "agents/capabilities/jira",
    "tool_paths": ["agents/capabilities/jira/tools"],
    "tool_target": {
        "source": "agents/capabilities/jira/tools",
        "target": "/opt/jira-tools",
        "expose_commands": [
            "jira-read",
            "jira-createmeta",
            "jira-attachment",
            "jira-search",
            "jira-query",
            "jira-transition",
            "jira-comment",
            "jira-confirm-plan",
            "jira-update",
            "jira-create",
            "jira-attach"
        ]
    },
    "skill_path": "agents/capabilities/jira/SKILL.md",
    "primer_path": "agents/capabilities/jira/primer.md",
    "probe": {
        "kind": "command",
        "entrypoint": "jira-read --probe"
    },
    "notes": "Broker-backed: reads call the dashboard's /api/jira/* routes (the Jira call runs host-side); writes stage kind=jira_write approval requests and execute host-side only after the operator approves. The Jira token lives on the host only — no required_env, no secret file mounts, nothing credential-shaped in the container."
}
