#!/usr/bin/env bash
# Usage: jira-attach ISSUE_KEY FILE
# Uploads FILE as an attachment — staged for operator approval (they see the
# filename and size); blocks until decided. 10MB cap.
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_jira_lib.sh"

KEY="${1:-}"; FILE="${2:-}"
[ -n "$KEY" ] && [ -n "$FILE" ] || jira_fail "usage: jira-attach ISSUE_KEY FILE"
[ -f "$FILE" ] || jira_fail "jira-attach: file not found: $FILE"

req_file="$(mktemp)"
trap 'rm -f "$req_file"' EXIT
python3 - "$SESSION" "$KEY" "$FILE" > "$req_file" <<'PY' || exit 1
import base64, json, mimetypes, os, sys
session, key, path = sys.argv[1:4]
size = os.path.getsize(path)
if size > 10 * 1024 * 1024:
    sys.exit(f"jira-attach: {path} is {size} bytes; the cap is 10MB")
print(json.dumps({"kind": "jira_write", "session": session, "request": {
    "op": "attach", "key": key,
    "filename": os.path.basename(path),
    "size": size,
    "mime_type": mimetypes.guess_type(path)[0] or "application/octet-stream",
    "content_b64": base64.b64encode(open(path, "rb").read()).decode("ascii"),
}}))
PY
jira_approval_wait "$req_file"
