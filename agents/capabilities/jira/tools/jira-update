#!/usr/bin/env bash
# Usage: jira-update ISSUE_KEY --field "Description" -f body.md   (or stdin)
# Sets a rich-text or supported structured field by display name (or
# customfield_NNNNN id) — staged for operator approval; blocks until decided.
# The field id and schema are discovered from the issue's editmeta host-side,
# so display names work across instances. Rich-text bodies are markdown
# converted to ADF; structured values are schema-coerced (comma-separated
# arrays, users by display name/email).
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_jira_lib.sh"

KEY="${1:-}"
[ -n "$KEY" ] || jira_fail "usage: jira-update ISSUE_KEY --field NAME -f body.md (or stdin)"
shift

FIELD=""
if [ "${1:-}" = "--field" ]; then
  [ -n "${2:-}" ] || jira_fail "jira-update: --field needs a value (e.g. --field Description)"
  FIELD="$2"; shift 2
fi
[ -n "$FIELD" ] || jira_fail "jira-update: --field NAME is required (e.g. --field Description)"

# Story Points commonly lives off the issue edit screen, so Jira omits it from
# editmeta. Preserve the familiar jira-update surface (including --value) by
# delegating to the board-estimation command before the editmeta preflight.
case "${FIELD,,}" in
  "story points"|"story point")
    if [ "${1:-}" = "--value" ]; then
      [ -n "${2:-}" ] || jira_fail "jira-update: --value needs a story-points value"
      POINTS_VALUE="$2"; shift 2
    else
      POINTS_VALUE="$(jira_read_body "$@")"
      shift "$#"
    fi
    [ -n "$POINTS_VALUE" ] || jira_fail "jira-update: empty Story Points value"
    exec "$(dirname "${BASH_SOURCE[0]}")/jira-points" "$KEY" "$POINTS_VALUE"
    ;;
esac

# Read-only preflight before staging approval. A typo used to reach editmeta
# only after approval, leaving a junk failed-write audit row. Validate against
# the same authoritative field list that powers jira-fields instead.
jira_curl -sk "$DASH/api/jira/fields/$KEY?org=$ORG" \
  | python3 -c 'import json, sys
field = sys.argv[1]
d = json.load(sys.stdin)
if "error" in d: sys.exit("jira: " + str(d["error"]))
rows = d.get("fields") or []
want = field.strip().casefold()
match = next((f for f in rows if str(f.get("id") or "") == field), None) \
    or next((f for f in rows if str(f.get("name") or "").casefold() == want), None)
if match is None:
    close = [f for f in rows if want in str(f.get("name") or "").casefold()
             or str(f.get("name") or "").casefold() in want]
    hint = "; close matches: " + ", ".join(
        str(f.get("name")) + " (" + str(f.get("id")) + ")" for f in close
    ) if close else ""
    sys.exit("jira-update: unknown editable field " + repr(field) + hint
             + "\nRun jira-fields " + sys.argv[2]
             + " [FILTER] to discover exact names, ids, and allowed values."
             + " Nothing was staged for approval.")' "$FIELD" "$KEY" || exit 1

body_file="$(mktemp)"; req_file="$(mktemp)"
trap 'rm -f "$body_file" "$req_file"' EXIT
jira_read_body "$@" > "$body_file"
[ -s "$body_file" ] || jira_fail "jira-update: empty body"

python3 - "$SESSION" "$KEY" "$body_file" "$ORG" "$FIELD" > "$req_file" <<'PY'
import json, re, sys
session, key, path, org, field = sys.argv[1:6]
# A literal customfield id skips editmeta name discovery host-side.
field_key = "field_id" if re.fullmatch(r"customfield_\d+", field) else "field_name"
print(json.dumps({"kind": "jira_write", "session": session, "request": {
    "op": "set_field", "key": key, "org": org, field_key: field,
    "body_markdown": open(path).read()}}))
PY
jira_approval_wait "$req_file"
