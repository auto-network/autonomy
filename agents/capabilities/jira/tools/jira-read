#!/usr/bin/env bash
# Usage: jira-read ISSUE_KEY        — cleaned ticket JSON (ADF already markdown)
#        jira-read --probe          — capability probe (broker reachable + auth ok)
# Token-free: the Jira call runs host-side in the dashboard.
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_jira_lib.sh"

if [ "${1:-}" = "--probe" ]; then
  curl -skf "$DASH/api/jira/probe" || jira_fail "jira: broker probe failed at $DASH"
  exit 0
fi

KEY="${1:-}"
[ -n "$KEY" ] || jira_fail "usage: jira-read ISSUE_KEY (e.g. jira-read ENTERPRISE-8385)"

resp="$(curl -sk "$DASH/api/jira/issue/$KEY")"
echo "$resp" | python3 -c 'import sys,json
d=json.load(sys.stdin)
if "error" in d: sys.exit(f"jira: {d[\"error\"]}")
print(json.dumps(d, indent=2))'
