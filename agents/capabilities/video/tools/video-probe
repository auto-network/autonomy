#!/usr/bin/env bash
# Print a video's format and stream facts as JSON.
# Usage: video-probe <file>
set -euo pipefail
TOOLS_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=_video-common
source "$TOOLS_DIR/_video-common"
FFPROBE=$(video_binary ffprobe)
exec "$FFPROBE" -v error -print_format json -show_format -show_streams "$@"
