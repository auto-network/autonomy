#!/usr/bin/env bash
# Detect scene changes; print one line per cut: <timestamp-seconds> <score>.
# Usage: video-scene-detect <in-video> [--threshold 0.3] [--frames-dir DIR]
# With --frames-dir, also saves one PNG per detected scene into DIR.
set -euo pipefail
TOOLS_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=_video-common
source "$TOOLS_DIR/_video-common"
FFMPEG=$(video_binary ffmpeg)

IN=${1:?usage: video-scene-detect <in-video> [--threshold T] [--frames-dir DIR]}
shift
THRESH=0.3; FRAMES_DIR=""
while [ $# -gt 0 ]; do
  case "$1" in
    --threshold) THRESH=$2; shift 2 ;;
    --frames-dir) FRAMES_DIR=$2; shift 2 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done

if [ -n "$FRAMES_DIR" ]; then
  mkdir -p "$FRAMES_DIR"
  "$FFMPEG" -y -loglevel error -i "$IN" \
    -vf "select='gt(scene,$THRESH)'" -vsync vfr "$FRAMES_DIR/scene-%03d.png"
fi

"$FFMPEG" -loglevel info -i "$IN" \
  -vf "select='gt(scene,$THRESH)',metadata=print" -f null - 2>&1 |
  awk '/pts_time/ { for (i=1;i<=NF;i++) if ($i ~ /pts_time:/) { split($i,a,":"); t=a[2] } }
       /scene_score/ { for (i=1;i<=NF;i++) if ($i ~ /scene_score=/) { split($i,b,"="); print t, b[2] } }'
