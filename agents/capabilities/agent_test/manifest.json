{
  "name": "autonomy/agent-test",
  "version": 3,
  "implements": [
    {"contract": "test_execution", "version": 1}
  ],
  "delivery_mode": "mounted_tools",
  "package_root": "agents/capabilities/agent_test",
  "tool_target": {
    "source": "tools/agent_test",
    "target": "/opt/agent_test",
    "expose_commands": ["agent-test", "pytest", "py.test"]
  },
  "skill_path": "agents/capabilities/agent_test/SKILL.md",
  "primer_path": "agents/capabilities/agent_test/primer.md",
  "probe": {
    "kind": "command",
    "entrypoint": "agent-test --version"
  },
  "notes": "Agent-oriented Python test execution with retained evidence, bounded output, background notifications, organization telemetry, and machine-wide capacity coordination."
}
