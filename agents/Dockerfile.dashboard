# Dashboard Agent Container
# Extends base autonomy-agent with Python deps for dashboard API contract tests.
# Chrome/agent-browser/tmux are already in the base image.
#
# Build:  ./agents/build.sh --dashboard
# Run:    see agents/launch.sh (dispatcher routes dashboard-labeled beads here)

FROM autonomy-agent

# ── Dashboard Python deps (Starlette TestClient / API contract tests) ──
USER root
# Versions pinned 2026-04-15 — update deliberately when host .venv changes
RUN pip install --break-system-packages --no-cache-dir \
        "starlette>=1.0,<2" \
        "fastapi==0.139.2" \
        "httpx==0.28.1" \
        "uvicorn==0.44.0" \
        "jinja2==3.1.6" \
        "pymysql==1.1.2" \
        "sse-starlette==3.3.4" \
        "inotify_simple==2.0.1" \
        "pytest-asyncio==1.3.0" \
        "webauthn==3.0.0" \
        "cbor2==6.1.3" \
        "websockets>=13,<17"
        # ↑ websockets added in S3-4a (graph://86fd1897-d4d). Outbound async
        # ws client to WhisperLive on 127.0.0.1:9090 plus the uvicorn
        # server-side ws protocol implementation production needs.

# ── Tailwind standalone binary (v4, matches tailwind.input.css) ──
# The dashboard's CSS (static/tailwind.css) is built from tailwind.input.css by
# start-dashboard.sh and by dashboard-mock. Baking the binary in means no network
# fetch at startup; the launchers prefer this on PATH over downloading.
RUN curl -sL "https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.2/tailwindcss-linux-x64" \
        -o /usr/local/bin/tailwindcss \
    && chmod +x /usr/local/bin/tailwindcss

# ── Archive tooling ──
# zip/unzip so sessions can handle archives directly instead of scripting
# around Python's zipfile. Requested for the Idea Board workspace, which shares
# this image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends zip unzip \
    && rm -rf /var/lib/apt/lists/*

USER agent
ENTRYPOINT ["claude", "--dangerously-skip-permissions"]
